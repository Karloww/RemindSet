{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "admin",
        "teacher"
      ],
      "default": "teacher"
    },
    "author_name": {
      "type": "string"
    },
    "classroom_id": {
      "type": "string"
    },
    "classroom_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "likes": {
      "type": "string",
      "default": "[]"
    }
  },
  "required": [
    "title",
    "message",
    "type"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}