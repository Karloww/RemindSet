{
  "name": "LessonPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "points_reward": {
      "type": "number",
      "default": 10
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time"
    },
    "classroom_id": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "title",
    "subject",
    "teacher_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}