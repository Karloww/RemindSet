{
  "name": "Profile",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "student",
        "teacher"
      ],
      "default": "student"
    },
    "bio": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "profile_picture_url": {
      "type": "string"
    },
    "cover_photo_url": {
      "type": "string"
    },
    "selected_color_theme": {
      "type": "string",
      "default": "ocean"
    },
    "selected_background": {
      "type": "string",
      "default": "none"
    },
    "selected_cover_photo": {
      "type": "string",
      "default": "default"
    },
    "selected_profile_icon": {
      "type": "string",
      "default": "default"
    },
    "notify_activity": {
      "type": "boolean",
      "default": true
    },
    "notify_lesson": {
      "type": "boolean",
      "default": true
    },
    "notify_message": {
      "type": "boolean",
      "default": true
    },
    "email_notifications": {
      "type": "boolean",
      "default": false
    },
    "show_online": {
      "type": "boolean",
      "default": true
    },
    "allow_friendships": {
      "type": "boolean",
      "default": true
    },
    "appear_in_search": {
      "type": "boolean",
      "default": true
    },
    "social_media": {
      "type": "string"
    },
    "teacher_activity_done": {
      "type": "string",
      "enum": [
        "every_student",
        "after_deadline",
        "disabled"
      ],
      "default": "every_student"
    },
    "teacher_lesson_done": {
      "type": "string",
      "enum": [
        "every_student",
        "disabled"
      ],
      "default": "every_student"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "username",
    "account_type"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}