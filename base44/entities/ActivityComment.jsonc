      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "account_type": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "activity_id",
    "user_id",
    "user_name",
    "message"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
