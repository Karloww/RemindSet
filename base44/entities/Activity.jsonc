{
  "name": "Activity",
  "type": "object",
  "properties": {
    "classroom_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "quiz",
        "upload_link"
      ],
      "default": "quiz"
    },
    "questions": {
      "type": "string"
    },
    "settings": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "default_points": {
      "type": "number",
      "default": 1
    },
    "jumble_questions": {
      "type": "boolean",
      "default": false
    },
    "jumble_choices": {
      "type": "boolean",
      "default": false
    },
    "require_all": {
      "type": "boolean",
      "default": true
    },
    "allow_prev": {
      "type": "boolean",
      "default": true
    },
    "allow_pause": {
      "type": "boolean",
      "default": true
    },
    "assigned_student_ids": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "link_url": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "time_limit_minutes": {
      "type": "number"
    },
    "coins_reward": {
      "type": "number",
      "default": 0
    },
    "max_retakes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "classroom_id",
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}